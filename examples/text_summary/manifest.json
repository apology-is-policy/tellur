        { "name": "lines", "type": "u32" },
        { "name": "words", "type": "map<string,u32>" }
      ] },
      { "name": "blank", "fields": [] },
      { "name": "too_large", "fields": [] }
    ],
    "effects": [],
    "returns": true,
    "rust": { "execution": "immediate" }
  }]
}
