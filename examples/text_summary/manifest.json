{
  "version": "0.1",
  "types": [],
  "rust": {
    "source": "host.rs",
    "lockfile": "Cargo.lock",
    "modules": { "words": "words.rs" }
  },
  "primitives": [{
    "name": "summarize",
    "parameters": [{ "name": "text", "type": "string", "mode": "borrow" }],
