          "mode": "value"
        }
      ],
      "outcomes": [
        {
          "name": "difference",
          "fields": [
            {
              "name": "value0",
              "type": "u32"
            }
          ]
        },
        {
          "name": "underflow",
          "fields": []
        }
      ],
      "effects": [],
      "returns": true
    },
    {
      "name": "concat",
      "parameters": [
        {
          "name": "left",
          "type": "string",
          "mode": "value"
        },
        {
          "name": "right",
          "type": "string",
          "mode": "value"
        }
      ],
      "outcomes": [
        {
          "name": "text",
          "fields": [
            {
              "name": "value0",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [],
      "returns": true,
      "pure": true
    },
    {
      "name": "http_reply_failure",
      "contingent": true,
      "parameters": [
        {
          "name": "connection",
          "type": "http_connection",
          "mode": "borrow"
        }
      ],
      "outcomes": [
        {
          "name": "sent",
          "fields": []
        },
        {
          "name": "unavailable",
          "fields": []
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.write"
      ],
      "returns": true,
      "rust": {
        "execution": "blocking"
      }
    }
  ],
  "rust": {
    "source": "host.rs",
    "lockfile": "Cargo.lock",
    "dependencies": {
      "httparse": {
        "version": "=1.10.1"
      }
    },
    "resources": {
      "http_listener": "Listener",
      "http_connection": "Connection"
    },
    "modules": {
      "http": "../../library/host/loopback_http.rs",
      "http_receive": "../../library/host/loopback_http_receive.rs",
      "http_accept": "../../library/host/loopback_http_accept.rs",
      "http_send": "../../library/host/loopback_http_send.rs"
    }
  }
}
