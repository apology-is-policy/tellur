{
  "version": "0.1",
  "types": [
    {
      "name": "http_listener",
      "kind": "opaque",
      "linear": true
    },
    {
      "name": "http_connection",
      "kind": "opaque",
      "linear": true,
      "fault": "release"
    }
  ],
  "primitives": [
    {
      "name": "http_listen",
      "parameters": [
        {
          "name": "port",
          "type": "u32",
          "mode": "value"
        }
      ],
      "outcomes": [
        {
          "name": "listening",
          "fields": [
            {
              "name": "listener",
              "type": "http_listener"
            },
            {
              "name": "authority",
              "type": "string"
            }
          ]
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.listen"
      ],
      "returns": true,
      "rust": {
        "execution": "blocking"
      }
    },
    {
      "name": "http_accept",
      "async": true,
      "parameters": [
        {
          "name": "listener",
          "type": "http_listener",
          "mode": "borrow"
        },
        {
          "name": "idle_ms",
          "type": "u32",
          "mode": "value"
        }
      ],
      "outcomes": [
        {
          "name": "accepted",
          "fields": [
            {
              "name": "connection",
              "type": "http_connection"
            }
          ]
        },
        {
          "name": "idle",
          "fields": []
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.accept"
      ],
      "returns": true,
      "rust": {
        "execution": "poll"
      }
    },
    {
      "name": "http_receive",
      "async": true,
      "parameters": [
        {
          "name": "connection",
          "type": "http_connection",
          "mode": "borrow"
        }
      ],
      "outcomes": [
        {
          "name": "request",
          "fields": [
            {
              "name": "method",
              "type": "string"
            },
            {
              "name": "target",
              "type": "string"
            },
            {
              "name": "headers",
              "type": "map<string,string>"
            },
            {
              "name": "body",
              "type": "string"
            }
          ]
        },
        {
          "name": "malformed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        },
        {
          "name": "headers_too_large",
          "fields": []
        },
        {
          "name": "body_too_large",
          "fields": []
        },
        {
          "name": "unsupported_transfer",
          "fields": []
        },
        {
          "name": "unsupported_expectation",
          "fields": []
        },
        {
          "name": "timed_out",
          "fields": []
        },
        {
          "name": "disconnected",
          "fields": []
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.read"
      ],
      "returns": true,
      "rust": {
        "execution": "poll"
      }
    },
    {
      "name": "http_send",
      "async": true,
      "parameters": [
        {
          "name": "connection",
          "type": "http_connection",
          "mode": "borrow"
        },
        {
          "name": "status",
          "type": "u32",
          "mode": "value"
        },
        {
          "name": "body",
          "type": "string",
          "mode": "consume"
        },
        {
          "name": "media",
          "type": "string",
          "mode": "consume"
        },
        {
          "name": "allow",
          "type": "string",
          "mode": "consume"
        }
      ],
      "outcomes": [
        {
          "name": "sent",
          "fields": []
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.write"
      ],
      "returns": true,
      "rust": {
        "execution": "poll"
      }
    },
    {
      "name": "http_connection_close",
      "parameters": [
        {
          "name": "connection",
          "type": "http_connection",
          "mode": "consume"
        }
      ],
      "outcomes": [
        {
          "name": "closed",
          "fields": []
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.shutdown",
        "net.read",
        "net.release"
      ],
      "returns": true,
      "rust": {
        "execution": "blocking"
      },
      "contingent": true
    },
    {
      "name": "http_connection_finish",
      "async": true,
      "parameters": [
        {
          "name": "connection",
          "type": "http_connection",
          "mode": "consume"
        }
      ],
      "outcomes": [
        {
          "name": "closed",
          "fields": []
        },
        {
          "name": "failed",
          "fields": [
            {
              "name": "message",
              "type": "string"
            }
          ]
        }
      ],
      "effects": [
        "net.shutdown",
        "net.read",
        "net.release"
      ],
      "returns": true,
      "rust": {
        "execution": "poll"
      }
    },
    {
      "name": "http_listener_release",
      "parameters": [
        {
          "name": "listener",
          "type": "http_listener",
          "mode": "consume"
        }
      ],
      "outcomes": [
        {
          "name": "released",
          "fields": []
        }
      ],
      "effects": [
        "net.release"
      ],
      "returns": true,
      "rust": {
        "execution": "blocking"
      }
    },
    {
      "name": "checked_sub",
      "parameters": [
        {
          "name": "a",
          "type": "u32",
          "mode": "value"
        },
        {
          "name": "b",
