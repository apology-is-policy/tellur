import "ordering.vn" as ordering;
struct ticket {
    u32 key;
    handle token;
    u32 identity;
}
struct key_order {}
implement ordering.comparator for key_order {
    type item = ticket;
    control compare(ref key_order rule, ref ticket a, ref ticket b) exits before,
        equal,
        after
    {
        emit(u32_text(a.identity));
        emit(u32_text(b.identity));
        delta (a.key < b.key) {
            true => exit before,
            false => next
        }
        [next]: exit delta (a.key > b.key) {
            true => after {},
            false => equal {}
        };
    }
}
control main(vector<ticket> source) exits sorted { vector<ticket> values } {
    key_order rule = key_order {};
    forward ordering.sort<key_order>(source, borrow rule);
}

control settle(vector<ticket> source) exits done {
    delta main(source) {
        sorted { auto values } => sorted
    }
    [sorted]: {
        loop finish(vector<ticket> rest = values) {
            delta vector_take(rest) {
                item { auto value, auto tail } => item,
                empty => exit done
            }
            [item]: delta close(value.token) {
                closed => closed,
                failed { auto reason } => failed
            }
            [closed | failed]: again finish(tail);
        }
    }
}
