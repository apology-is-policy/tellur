async control leaf(string owned, ref mutable string text)
    exits ready { string owned, ref mutable string value from text }
{
    emit("child");
    deref text = "edited";
    exit ready { move owned, text };
}

async control start(string initial) exits done faults {
    fault boundary {
        mutable string text = move initial;
        auto pending = defer leaf("payload", borrow mutable text);
        emit("queued");
        delta await pending {
            ready { auto owned, auto value } => received
        }

        [received]:
            emit(borrow owned);
            emit(value);
            drop(value);
            text = "released";
            emit(borrow text);
            exit done;
    } contingency [] {
        emit("forbidden nested contingency");
        escalate;
    }
}

control main() exits done {
    fault boundary {
        emit("process armed");
        fault "stop";
    } contingency [] {
        emit("process selected");
        terminate process 23;
    }
}
