async control leaf(ref http_connection resource)
    exits ready { ref http_connection value from resource } {
    delta http_receive(resource) {
        request {
            string method,
            string target,
            map<string, string> headers,
            string body
        } => received_0,
        malformed { string message } => received_1,
        headers_too_large => received_2,
        body_too_large => received_3,
        unsupported_transfer => received_4,
        unsupported_expectation => received_5,
        timed_out => received_6,
        disconnected => received_7,
        failed { string message } => received_8
    }
    [received_0]: emit("forbidden normal arm");
        exit ready { resource };
    [received_1]: emit("forbidden normal arm");
        exit ready { resource };
    [received_2]: emit("forbidden normal arm");
        exit ready { resource };
    [received_3]: emit("forbidden normal arm");
        exit ready { resource };
    [received_4]: emit("forbidden normal arm");
        exit ready { resource };
    [received_5]: emit("forbidden normal arm");
        exit ready { resource };
    [received_6]: emit("forbidden normal arm");
        exit ready { resource };
    [received_7]: emit("forbidden normal arm");
        exit ready { resource };
    [received_8]: emit("forbidden normal arm");
        exit ready { resource };
}
async control worker(ref http_connection resource) exits done {
    auto pending = defer leaf(resource);
    emit("captured");
    delta await pending {
        ready { auto value } => received
    }
    [received]: emit("forbidden worker arm");
        exit done;
}

control lexical(string request) exits done faults {
    fault boundary {
        delta open_case(move request) {
            opened { http_connection inner } => made
        }

        [made]:
            run worker(borrow inner);
            close_test(inner);
    } contingency [] {
        emit("forbidden lexical contingency");
        escalate;
    }
    exit done;
}

boundary nested_request(http_connection retained, string request) retains retained {
    lexical(move request);
    close_test(retained);
    terminate;
}
contingency(string reason) {
    emit("forbidden named contingency");
    close_test(retained);
    terminate;
}

control named(string request) exits done {
    delta open_case("retained") {
        opened { http_connection retained } => made
    }

    [made]:
        supervise nested_request(retained, move request);
        exit done;
}

boundary owner_request(http_connection retained) retains retained {
    emit("owner ready");
    fault "owning failure";
}
contingency(string reason) {
    checkpoint();
    emit("owning contingency");
    close_test(retained);
    terminate;
}

async control independent_leaf() exits done {
    emit("independent ready");
    emit("independent survived");
    exit done;
}

async control independent() exits done {
    auto pending = defer independent_leaf();
    await pending;
    exit done;
}

control main() exits done {
    delta open_case("owner") {
        opened { http_connection owner } => made
    }

    [made]:
        supervise owner_request(owner);
        exit done;
}
