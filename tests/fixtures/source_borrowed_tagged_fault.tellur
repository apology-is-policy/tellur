variant edit_view['text] {
    held { ref mutable string text <- 'text },
    empty
}
variant read_view['text] {
    held { ref string text <- 'text },
    empty
}
async control lend(ref mutable edit_view input) exits ready..., empty {
    delta input {
        held { auto text } => held,
        empty => empty
    }
    [held]: emit("result completed");
        exit ready { borrow mutable deref text };
    [empty]: exit empty;
}
async control sibling(ref read_view input) exits done {
    delta input {
        held { auto text } => held,
        empty => empty
    }
    [held]: emit(text);
        fault boundary {
            yield;
            yield;
        } contingency [] {
            emit("stopped nested handler");
            escalate;
        }
    [entry]: emit("stopped sibling resumed");
        exit done;
}
async control fail() faults {
    yield;
    fault "child failed";
}
async control startup() exits done faults {
    mutable string text = "original";
    string peer = "sibling started";
    mutable edit_view editing = edit_view.held { borrow mutable text };
    read_view reading = read_view.held { borrow peer };
    auto result = spawn lend(borrow mutable editing);
    auto worker = spawn sibling(borrow reading);
    auto failure = spawn fail();
    yield;
    yield;
    delta await result {
        ready { auto value } => ready,
        empty => empty
    }
    [ready]: emit("stopped parent resumed");
        emit(value);
    [entry]: await worker;
        await failure;
}
async control outer() exits done faults {
    await startup();
    exit done;
}
control main() exits done {
    fault boundary {
        run outer();
    } contingency [] {
        emit("owner contingency");
        terminate process 23;
    }
    exit done;
}
