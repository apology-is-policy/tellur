variant choice['text] {
    held { ref mutable string text <- 'text },
    empty
}
struct holder['text] {
    option<choice>['text] item;
}
async control lend(ref mutable holder input) exits ready..., empty {
    delta borrow mutable input.item {
        some { auto selected } => some,
        none => none
    }
    [some]: delta selected {
        held { auto text } => held,
        empty => empty
    }
    [held]: yield;
        exit ready { borrow mutable deref text };
    [none | empty]: exit empty;
}
async control startup() exits done {
    mutable string owner = "before";
    mutable holder saved = holder { some { choice.held { borrow mutable owner } } };
    ref mutable holder carrier = borrow mutable saved;
    auto pending = spawn lend(carrier);
    yield;
    yield;
    auto moved = move pending;
    delta await moved {
        ready { auto value } => ready,
        empty => empty
    }
    [ready]: deref value = "after";
        emit(value);
    [entry]: drop(saved);
        owner = "free";
        exit done;
}
control main() exits done {
    forward run startup();
}
