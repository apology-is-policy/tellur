boundary request(counter owner, bool escape) retains owner, escape {
    emit("owner ready");
    inspect(borrow owner);
    emit("owner continued");
    close(owner);
    terminate;
}
contingency(string reason) {
    emit("owner handler");
    emit(reason);
    close(owner);
    delta escape {
        true => escaped,
        false => handled
    }
    [escaped]: escalate;
    [handled]: terminate;
}

boundary nested(counter local, string path) retains local {
    fault boundary {
        delta make(borrow path, 4) {
            made { counter inner } => made
        }
        [made]:
            emit("sibling ready");
            inspect(borrow inner);
            close(inner);
    } contingency [] {
        emit("forbidden lexical handler");
        escalate;
    }
    close(local);
    emit("sibling continued");
    terminate;
}
contingency(string reason) {
    emit("forbidden named handler");
    close(local);
    terminate;
}

control sibling(ref counter owner, string path) exits done {
    inspect(owner);
    delta make(borrow path, 2) {
        made { counter local } => made
    }

    [made]:
        supervise nested(local, path);
        exit done;
}

control descendant(ref counter local) exits done {
    emit("descendant ready");
    inspect(local);
    emit("descendant continued");
    exit done;
}

boundary handling(counter local) retains local {
    fault "sibling local";
}
contingency(string reason) {
    emit("sibling handler ready");
    close(local);
    emit("forbidden handler continuation");
    terminate;
}

control sibling_named_handler(ref counter owner, string path) exits done {
    inspect(owner);
    delta make(borrow path, 2) {
        made { counter local } => made
    }
    [made]:
        supervise handling(local);
        exit done;
}

control sibling_lexical_handler(ref counter owner, string path) exits done faults {
    inspect(owner);
    delta make(borrow path, 2) {
        made { counter local } => made
    }
    [made]:
        fault boundary {
            fault "sibling local";
        } contingency [local] {
            emit("sibling handler ready");
            close(local);
            emit("forbidden handler continuation");
            escalate;
        }
}

control failing(ref counter owner) exits done faults {
    inspect(owner);
    fault "child failed";
}

boundary local_recovery() {
    fault "local child";
}
contingency(string reason) {
    emit("local recovered");
    terminate;
}

control recovering(ref counter owner) exits done {
    inspect(owner);
    supervise local_recovery();
    exit done;
}

control unstarted(counter value) exits done {
    emit("unstarted body");
    close(value);
    exit done;
}

control independent(string path) exits done {
    delta make(borrow path, 3) {
        made { counter value } => made
    }

    [made]:
        emit("independent ready");
        inspect(borrow value);
        close(value);
        emit("independent complete");
        exit done;
}

control root_unhandled(string path) exits done faults {
    delta make(borrow path, 1) {
        made { counter value } => made
    }
    [made]:
        supervise request(value, true);
        emit("owner complete");
        exit done;
}

control ancestor(string path) exits done faults {
    delta make(borrow path, 6) {
        made { counter value } => made
    }
    [made]:
        supervise request(value, false);
        emit("forbidden ancestor continuation");
        exit done;
}

control main(string path) exits done faults {
    delta make(borrow path, 1) {
        made { counter value } => made
    }

    [made]:
        supervise request(value, false);
        emit("owner complete");
        exit done;
}
