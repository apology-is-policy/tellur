[package]
name = "path_generated"
version = "0.1.0"
edition = "2024"
[workspace]
[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"

# Each output directory names a distinct generated crate. Keep dependency reuse,
# but avoid accumulating a large incremental query cache for every test/output.
[profile.dev]
incremental = false
