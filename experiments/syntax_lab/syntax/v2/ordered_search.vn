import "ordering.vn" as ordering;

// The source must already be sorted under the same consistent total preorder.
// The checker validates the comparator interface, not the ordering laws.
pub control lower_bound<order: ordering.comparator>(
    ref vector<order.item> source, ref order rule, ref order.item needle
) exits position { u32 index } when index <= len(source)
{
    forward bound(source, rule, needle, false);
}

pub control upper_bound<order: ordering.comparator>(
    ref vector<order.item> source, ref order rule, ref order.item needle
) exits position { u32 index } when index <= len(source)
{
    forward bound(source, rule, needle, true);
}

control bound<order: ordering.comparator>(
    ref vector<order.item> source, ref order rule, ref order.item needle, bool upper
) exits position { u32 index } when index <= len(source)
{
    loop search(u32 start = 0, u32 count = len(source))
        where start + count <= len(source)
    {
        if count == 0 { exit position { start }; }

        u32 half = count / 2;
        u32 middle = start + half;
        delta rule.compare(source[middle], needle) { before, equal, after }

        [equal]:
            delta upper { true => high, false => low }

        [after | low]:
            again search(start, half);
        [before | high]:
            again search(middle + 1, count - half - 1);
    }
}
