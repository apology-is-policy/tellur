+#[test]
+fn compact_projection_preserves_snapshots_and_path_limit() {
+    let mut values = Frames::default();
+    let frame = values.enter(1).unwrap();
+    for count in [0, 1, 4, LIMIT - 1] {
+        let path = vec![0; count];
+        let original = ReferenceEvidence::from_place(&values, frame.base(), &path, false);
+        let empty = original.clone().into_projected(&[]);
+        assert_eq!(original, empty);
+        let extended = original.clone().into_projected(&[2]);
+        assert_eq!(original.target.as_ref().unwrap().fields.as_ref(), path.as_slice());
+        let mut expected = path.clone(); expected.push(2);
+        assert_eq!(extended.target.as_ref().unwrap().fields.as_ref(), expected.as_slice());
+        let overflow = extended.into_projected(&vec![0; LIMIT]);
+        assert!(overflow.target.is_none());
+        assert!(matches!(overflow.origins, Origins::Unavailable(_)));
+        assert_eq!(original.target.as_ref().unwrap().fields.as_ref(), path.as_slice());
+    }
+}
