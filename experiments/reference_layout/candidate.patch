+#[test]
+fn shared_formation_projection_keeps_prior_snapshots_independent() {
+    let mut values = Frames::default();
+    let frame = values.enter(1).unwrap();
+    let root = frame.base();
+    let original = ReferenceEvidence::from_place(&values, root, &[0], false);
+    let shared = original.clone();
+    assert!(std::sync::Arc::ptr_eq(original.target.as_ref().unwrap(), shared.target.as_ref().unwrap()));
+    let projected = shared.into_projected(&[2]);
+    assert_eq!(original.target.as_ref().unwrap().fields, [0]);
+    assert_eq!(projected.target.as_ref().unwrap().fields, [0, 2]);
+    assert!(!std::sync::Arc::ptr_eq(original.target.as_ref().unwrap(), projected.target.as_ref().unwrap()));
+    let unchanged = original.clone().into_projected(&vec![0; LIMIT]);
+    assert!(unchanged.target.is_none());
+    assert_eq!(original.target.as_ref().unwrap().fields, [0]);
+}
