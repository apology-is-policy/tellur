┄ Section 2 of `docs/v2/surface.md`: `show_file` with an actual resource,
┄ strings, move mark `▾file`, built-in `emit`, and dotted effects.

extern resource file_handle on fault release

extern control open(filename: &string)
    ■ opened {file: file_handle}
    ■ not_found
    ■ denied uses file.read
extern control read(file: &file_handle) ■ data {contents: string} │ failed uses file.read
extern control close(file: file_handle) ■ closed │ failed uses file.read
extern control decode_utf8(contents: &string) ■ text {text: string} │ invalid

control show_file(filename: string) ■ auto
│ Δ open(filename)
│ ├ opened {file}
│ ├ not_found → ■ missing
│ └ denied    → ■ failed
│ Δ read(file): data {contents} │ failed
│
│ ┄ Always attempt close, even if reading failed.
│ Δ close(▾file): closed │ failed
│
╞═ data
│ ┆ Δ decode_utf8(contents): text {text} → decoded │ invalid
│
╞═ decoded ∧ closed
│ ┆ emit(text)
│ ┆ ■ done
╞═ read.failed ∨ close.failed ∨ invalid
│ ┆ ■ failed
╵

//! run show_file("notes.txt") with [open -> opened {file_handle#1}; read -> data {"hello"}; close -> closed; decode_utf8 -> text {"hello"}] => done done trace [open("notes.txt") -> opened {file_handle#1}; read(file_handle#1) -> data {"hello"}; close(file_handle#1) -> closed; emit("hello") -> done]
//! run show_file("absent.txt") with [open -> not_found] => done missing trace [open("absent.txt") -> not_found]
//! run show_file("secret.txt") with [open -> denied] => done failed trace [open("secret.txt") -> denied]
//! run show_file("broken.txt") with [open -> opened {file_handle#2}; read -> failed; close -> closed] => done failed trace [open("broken.txt") -> opened {file_handle#2}; read(file_handle#2) -> failed; close(file_handle#2) -> closed]
//! run show_file("badutf8.txt") with [open -> opened {file_handle#3}; read -> data {"?"}; close -> closed; decode_utf8 -> invalid] => done failed trace [open("badutf8.txt") -> opened {file_handle#3}; read(file_handle#3) -> data {"?"}; close(file_handle#3) -> closed]
