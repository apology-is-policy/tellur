// Transport contracts; `accept`, `receive`, `send` and `finish` are async (await
// them, or `run` them from synchronous code). `close` and `reply_failure` stay
// synchronous for contingencies. Routing, supervision and status policy belong to callers. Supply the
// matching retained-resource primitives in the manifest.
pub outcome listen_result {
    listening { http_listener listener, string authority },
    failed { string message }
}

pub outcome accept_result {
    accepted { http_connection connection },
    idle,
    failed { string message }
}

pub outcome receive_result {
    request { string method, string target, map<string, string> headers, string body },
    malformed { string message },
    headers_too_large,
    body_too_large,
    unsupported_transfer,
    unsupported_expectation,
    timed_out,
    disconnected,
    failed { string message }
}

// The same alternatives plus `cancelled`, selected when the caller's task (or the
// entry, after a launch signal) is cancelled while the operation waits.
pub outcome cancellable_accept_result {
    accepted { http_connection connection },
    idle,
    failed { string message },
    cancelled
}

pub outcome cancellable_receive_result {
    request { string method, string target, map<string, string> headers, string body },
    malformed { string message },
    headers_too_large,
    body_too_large,
    unsupported_transfer,
    unsupported_expectation,
    timed_out,
    disconnected,
    failed { string message },
    cancelled
}

pub outcome send_result {
    sent,
    failed { string message }
}

pub outcome close_result {
    closed,
    failed { string message }
}

pub outcome failure_reply_result {
    sent,
    unavailable,
    failed { string message }
}

pub control listen(u32 port) exits listen_result {
    forward http_listen(port);
}

pub async control accept(ref http_listener listener, u32 idle_ms) exits accept_result {
    forward await http_accept(listener, idle_ms);
}

pub async control receive(ref http_connection connection) exits receive_result {
    forward await http_receive(connection);
}

// `accept` that stops waiting when cancelled.
pub async control accept_cancellable(
    ref http_listener listener,
    u32 idle_ms
) exits cancellable_accept_result {
    exit delta await http_accept(listener, idle_ms) {
        accepted { http_connection connection } => accepted { connection },
        idle => idle {},
        failed { string message } => failed { message },
        cancelled => cancelled {}
    };
}

// `receive` that stops reading when cancelled; the connection stays open.
pub async control receive_cancellable(
    ref http_connection connection
) exits cancellable_receive_result {
    exit delta await http_receive(connection) {
        request {
            string method,
            string target,
            map<string, string> headers,
            string body
        } => request { method, target, headers, body },
        malformed { string message } => malformed { message },
        headers_too_large => headers_too_large {},
        body_too_large => body_too_large {},
        unsupported_transfer => unsupported_transfer {},
        unsupported_expectation => unsupported_expectation {},
        timed_out => timed_out {},
        disconnected => disconnected {},
        failed { string message } => failed { message },
        cancelled => cancelled {}
    };
}

pub async control send(
    ref http_connection connection,
    u32 status,
    string body,
    string media,
    string allow
) exits send_result {
    forward await http_send(connection, status, move body, move media, move allow);
}

// Completes a connection like `close`, but parks while draining instead of
// blocking the executor. Use it on normal paths; contingencies use `close`.
pub async control finish(http_connection connection) exits close_result {
    forward await http_connection_finish(move connection);
}

@contingent
pub control close(http_connection connection) exits close_result {
    forward http_connection_close(connection);
}

pub control release(http_listener listener) exits released {
    forward http_listener_release(listener);
}

// Sends a fixed generic 500 only if ordinary transmission has not started.
// This is a permitted emergency operation; it never recovers the failed work.
@contingent
pub control reply_failure(ref http_connection connection) exits failure_reply_result {
    forward http_reply_failure(connection);
}
