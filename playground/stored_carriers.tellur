// Capture runs now; its completed result can be handled later.
struct text_view['source] {
    ref mutable string text <- 'source;
}

struct edit_job {
    ref mutable text_view target;
}

control lend(ref mutable text_view input) exits ready... {
    exit ready { input };
}

control main() exits process_result {
    mutable string owner = "before";
    mutable text_view saved = text_view { borrow mutable owner };

    auto pending = capture lend(borrow mutable saved);
    auto transferred = pending;
    delta transferred { ready { auto view } => received }
    [received]: deref view.text = "edited after capture";
    emit(view.text);

    // A local record can also store a reference to the reference-bearing view.
    mutable option<edit_job> queued = some { edit_job { borrow mutable saved } };
    delta borrow mutable queued { some { auto job } => present, none => absent }
    [present]: deref job.target.text = "edited through stored job";
    emit(job.target.text);

    [entry]: delta queued { some { auto final_job } => handled, none => empty }
    [handled]: emit(final_job.target.text);
    [entry]: drop(saved);
    exit done { owner };
}

// Process status policy for this runnable example.
outcome process_result { @exit 0 done { string final_text } }
