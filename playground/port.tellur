// Edit the input to "abc", "0", or "4294967296".
// Or invoke parse_port as the entry with a string argument.
control main() exits process_result {
    [entry]:
        delta parse_port("8080") {
            ready { u32 port } => valid,
            invalid { string message } => bad,
        }
    [valid]:
        string text = u32_text(port);
        emit(text);
        exit done;
    [bad]: emit(message); exit invalid;
}

control parse_port(string input) exits port_result {
    [entry]:
        delta parse_u32(input) {
            number { auto n } => parsed,
            malformed => bad_syntax,
            overflow => too_large,
        }
    [parsed]:
        delta (1 <= n && n <= 65535) {
            true => in_range,
            false => out_of_range,
        }
    [in_range]: exit ready { n };
    [bad_syntax]: exit invalid { "Use decimal digits." };
    [too_large]: exit invalid { "The number does not fit u32." };
    [out_of_range]: exit invalid { "A port must be between 1 and 65535." };
}

// Process status policy for this runnable example.
outcome process_result { @exit 0 done, @exit 2 invalid }

outcome port_result { @exit 0 ready { u32 port }, @exit 2 invalid { string message } }
