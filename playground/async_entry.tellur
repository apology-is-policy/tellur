// Direct async calls currently run sequentially. For local cold tasks, see cold_tasks.tellur.
// Async I/O remains planned.
async control greeting(string name) exits ready { string text } {
    exit ready { concat("Hello, ", name) };
}

async control startup() exits done {
    delta await greeting("Tellur") {
        ready { string text } => ready,
    }

    [ready]:
        emit(borrow text);
        exit done;
}

control main() exits program_result {
    forward run startup();
}

outcome program_result {
    @exit 0 done,
}
