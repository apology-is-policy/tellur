// Concrete execution finishes after two iterations. The protocol abstraction
// forgets the Boolean value, so it also admits endless silent retries.
control main() exits process_result {
    loop retry(bool repeat = true) {
        delta repeat { true => again, false => finished }
        [again]: again retry(false);
        [finished]: emit("finished"); exit done;
    }
}

// Process status policy for this runnable example.
outcome process_result { @exit 0 done }
