// Named source-fault isolation through the opt-in LLVM backend.
@contingent
control report(ref string context, string reason) exits done {
    emit(context);
    emit(reason);
    exit done;
}

boundary request(bool broken, string context) retains context {
    delta broken {
        true => failed,
        false => healthy
    }
    [failed]: fault "request invariant failed";
    [healthy]:
        emit(context);
        terminate;
}
contingency(string reason) {
    report(borrow context, reason);
    terminate;
}

control main(bool fail) exits result {
    supervise request(fail, "first request");
    supervise request(false, "second request");
    emit("supervisor continued");
    exit done;
}
outcome result {
    @exit 0 done
}
