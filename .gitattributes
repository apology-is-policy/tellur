# Native conformance tests derive programs by editing versioned Villanelle
# sources, including library modules and experiment programs. Keep their byte
# offsets and multiline edit anchors stable across checkouts: a CRLF checkout
# silently skips an anchor that contains a line break.
*.vn text eol=lf

# Native model tests splice embedded Rust templates and fixture drivers.
src/native/*.rs text eol=lf
tests/fixtures/**/*.rs text eol=lf

# A precompiled settings adapter identifies these inputs by their contents.
applications/settings/host.rs text eol=lf
applications/settings/Cargo.lock text eol=lf
library/host/*.rs text eol=lf
