import "http.tellur" as http;
import "../../library/loopback_http.tellur" as transport;

pub outcome service_result {
    @exit 0 completed,
    @exit 0 idle,
    @exit 0 stopped,
    @exit 1 failed { string message },
    @exit 2 invalid_configuration
}

pub control start(
    ref string path,
    u32 port,
    u32 max_connections,
    u32 idle_ms
) exits service_result {
    delta (port <= 65535
        && max_connections > 0
        && max_connections <= 1000000
        && idle_ms > 0
        && idle_ms <= 60000
    ) {
        true => valid,
        false => invalid
    }
    [invalid]: exit invalid_configuration;
    [valid]: delta transport.listen(port) {
        listening { http_listener listener, string authority } => listening,
        failed { string listen_message } => unavailable
    }
    [unavailable]: exit failed { listen_message };
    [listening]:
        emit(concat("http://", clone(borrow authority)));
        auto result = capture run serve(
            path,
            borrow listener,
            borrow authority,
            max_connections,
            idle_ms
        );
        transport.release(listener);
        exit delta result {
            completed => completed {},
            idle => idle {},
            stopped => stopped {},
            failed { string message } => failed { message }
        };
}

// Why the accept loop stopped admitting connections.
variant admission {
    open,
    exhausted,
    quiet,
    stopped,
    broken { string message }
}

// One global budget and idle timeout. Accepted connections run as members of one
// task set, at most `width` at a time; the loop stops admitting after the budget,
// an idle accept, an accept failure or cancellation, then drains the set. With
// `launch.serve.signals = "cancel"`, SIGINT or SIGTERM cancels the entry: the
// accept stops, waiting members reply 503 and finish, and the service stops.
async control serve(
    ref string path,
    ref http_listener listener,
    ref string authority,
    u32 limit,
    u32 idle_ms
) exits completed, idle, stopped, failed { string message } {
    loop serve_next(
        mutable u32 remaining = limit,
        admission state = admission.open {},
        tasks<serve_connection> active = tasks()
    ) {
        delta borrow state {
            open => admitting,
            exhausted => exhausted,
            quiet => quiet,
            stopped => stopped,
            broken { ref string reason } => broken
        }
        [admitting]: delta (count(borrow active) < 64) {
            true => room,
            false => full
        }
        [broken]: drop(reason);
        [exhausted | quiet | stopped | broken | full]:
            delta await next active {
                handled => reaped,
                empty => drained
            }
        [reaped]: again serve_next(remaining, state, active);
        [drained]:
            exit delta state {
                open => completed {},
                exhausted => completed {},
                quiet => idle {},
                stopped => stopped {},
                broken { string message } => failed { message }
            };
        [room]:
            delta checked_sub(remaining, 1) {
                difference { u32 next } => available,
                underflow => finished
            }
        [finished]: again serve_next(remaining, admission.exhausted {}, active);
        [available]:
            delta await transport.accept_cancellable(listener, idle_ms) {
                accepted { http_connection connection } => accepted,
                idle => idle,
                failed { string accept_message } => unavailable,
                cancelled => cancelled
            }
        [idle]: again serve_next(remaining, admission.quiet {}, active);
        [cancelled]:
            cancel active;
            again serve_next(remaining, admission.stopped {}, active);
        [unavailable]: again serve_next(remaining, admission.broken { accept_message }, active);
        [accepted]:
            spawn serve_connection(move connection, clone(path), clone(authority)) into active;
            again serve_next(next, state, active);
    }
}

// A member owns its connection and isolates its own request: a fault is handled
// by the named boundary and never stops sibling connections.
async control serve_connection(
    http_connection connection,
    string path,
    string authority
) exits handled {
    supervise request(connection, path, authority);
    exit handled;
}

boundary request(http_connection connection, string path, string authority) retains connection {
    auto exchange_result = capture exchange(borrow path, borrow authority, borrow connection);
    auto close_result = capture run transport.finish(connection);

    delta exchange_result {
        sent => sent,
        disconnected => disconnected,
        failed { string message } => failed
    }
    delta close_result {
        closed => closed,
        failed { string cleanup } => cleanup_failed
    }

    [failed]: emit(message);
    [cleanup_failed]: emit(cleanup);
    [entry]: terminate;
}
contingency(string reason) {
    emit(reason);
    auto reply_result = capture transport.reply_failure(borrow connection);
    auto close_result = capture transport.close(connection);

    delta reply_result {
        sent => sent,
        unavailable => unavailable,
        failed { string message } => failed
    }
    delta close_result {
        closed => closed,
        failed { string cleanup } => cleanup_failed
    }

    [failed]: emit(message);
    [cleanup_failed]: emit(cleanup);
    [entry]: terminate;
}

control exchange(
    ref string path,
    ref string authority,
    ref http_connection connection
) exits sent, disconnected, failed { string message } {
    exit delta prepare(path, authority, connection) {
        prepared { u32 status, string body, string media, string allow } => [prepared]:
            delta run transport.send(connection, status, body, media, allow) {
                sent => sent {},
                failed { string message } => failed { message }
            },
        disconnected => disconnected {},
        failed { string message } => failed { message }
    };
}

control prepare(
    ref string path,
    ref string authority,
    ref http_connection connection
) exits prepared {
        u32 status,
        string body,
        string media,
        string allow
    },
    disconnected,
    failed { string message }
{
    exit delta run transport.receive_cancellable(connection) {
        request {
            string method,
            string target,
            map<string, string> headers,
            string body
        } => [received]:
            delta http.route(path, authority, method, target, headers, body) {
                json { u32 status, string content } => prepared {
                    status,
                    content,
                    "application/json",
                    ""
                },
                text { u32 status, string content } => prepared {
                    status,
                    content,
                    "text/plain; charset=utf-8",
                    ""
                },
                method_not_allowed { string allow } => prepared {
                    405,
                    "Method not allowed",
                    "text/plain; charset=utf-8",
                    allow
                }
            },
        malformed { string message } => prepared { 400, message, "text/plain; charset=utf-8", "" },
        headers_too_large => prepared {
            431,
            "Request headers too large",
            "text/plain; charset=utf-8",
            ""
        },
        body_too_large => prepared {
            413,
            "Request body exceeds 1 MiB",
            "text/plain; charset=utf-8",
            ""
        },
        unsupported_transfer => prepared {
            501,
            "Transfer-Encoding is unsupported",
            "text/plain; charset=utf-8",
            ""
        },
        unsupported_expectation => prepared {
            417,
            "Expect is unsupported",
            "text/plain; charset=utf-8",
            ""
        },
        timed_out => prepared { 408, "Request deadline exceeded", "text/plain; charset=utf-8", "" },
        disconnected => disconnected {},
        failed { string message } => failed { message },
        cancelled => prepared { 503, "Service is shutting down", "text/plain; charset=utf-8", "" }
    };
}
