// Domain policy. The host exposes file/JSON/text mechanisms through the manifest.
pub outcome loaded_settings {
    loaded { map<string, string> values },
    invalid_file { string message },
    storage_failed { string message },
    too_large
}
pub outcome update_result {
    saved,
    invalid_key,
    invalid_file { string message },
    storage_failed { string message },
    commit_uncertain { string message },
    too_large
}
pub control load(ref string path) exits loaded_settings {
    exit delta file_read(path, 1048576) {
        read { string text } => [received]: delta json_decode(text) {
            decoded { map<string, string> values } => loaded { values },
            invalid { string message } => invalid_file { message }
        },
        missing => loaded { map {} },
        too_large => too_large {},
        read_failed { string message } => storage_failed { message }
    };
}
control validate_key(ref string key) exits valid, invalid {
    delta text_trim(key) { trimmed { string normalized } => trimmed }
    [trimmed]: exit delta (deref key == normalized && normalized != "") {
        true => valid {},
        false => invalid {}
    };
}
pub control set(ref string path, string key, string value) exits update_result {
    delta validate_key(borrow key) { valid => valid, invalid => invalid }
    [invalid]: exit invalid_key;
    [valid]:
        delta load(path) {
            loaded { map<string, string> loaded_values } => loaded,
            invalid_file { string message } => invalid_file,
            storage_failed { string message } => storage_failed,
            too_large => too_large
        }
    [invalid_file]: exit invalid_file { message };
    [storage_failed]: exit storage_failed { message };
    [too_large]: exit too_large;
    [loaded]:
        mutable map<string, string> values = loaded_values;
        delta map_insert(borrow mutable values, key, value) {
            inserted => changed,
            replaced { string previous } => replaced
        }
    [changed | replaced]:
        delta json_encode(borrow values) {
            encoded { string text } => encoded,
            encode_failed { string message } => encode_failed
        }
    [encode_failed]: exit storage_failed { message };
    [encoded]:
        exit delta file_replace(path, borrow text, 1048576) {
            replaced => saved {},
            write_failed { string write_message } => storage_failed { write_message },
            commit_uncertain { string uncertain_message } => commit_uncertain { uncertain_message },
            too_large => too_large {}
        };
}
pub control get(ref string path, ref string key)
    exits found { string value }, missing, invalid_key, invalid_file { string message }, storage_failed { string message }, too_large
{
    delta validate_key(key) { valid => valid, invalid => invalid }
    [invalid]: exit invalid_key;
    [valid]:
        exit delta load(path) {
            loaded { map<string, string> values } => [loaded]: delta map_get(borrow values, key) {
                found { ref string value } => found { clone(value) },
                missing => missing {}
            },
            invalid_file { string message } => invalid_file { message },
            storage_failed { string message } => storage_failed { message },
            too_large => too_large {}
        };
}
